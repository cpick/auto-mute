#!/usr/bin/env swift

import Foundation

class ScreenLockObserver {
    init() {
        let dnc = DistributedNotificationCenter.default()

        let _ = dnc.addObserver(forName: NSNotification.Name("com.apple.screenIsLocked"), object: nil, queue: .main) { _ in
            NSLog("Screen Locked")
            self.mute()
        }

        self.mute()

        RunLoop.main.run()
    }

    private func mute() {
        var error: NSDictionary?
        if let scriptObject = NSAppleScript(source: "set volume output muted true") {
            if let output = scriptObject.executeAndReturnError(&error).stringValue {
                NSLog(output)
            } else if (error != nil) {
                NSLog("Error: ", error!)
            }
        }
    }
}

let _ = ScreenLockObserver()
